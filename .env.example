# Copy this file to .env for local development. These are placeholders, not secrets.
COMPOSE_PROJECT_NAME=grocery-savings

POSTGRES_DB=grocery_savings
POSTGRES_USER=grocery_app
POSTGRES_PASSWORD=replace_me_for_local_development
POSTGRES_PORT=55432

KAFKA_EXTERNAL_PORT=9092
API_PORT=8000
INGESTION_PORT=8001

# Recommendation assumptions (one deployment currency and price per litre).
CURRENCY=CAD
FUEL_PRICE_PER_LITRE=1.60
ROAD_FACTOR=1.2
